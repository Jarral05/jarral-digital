{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1120px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "palette": [
        { "slug": "pine",      "color": "#14453A", "name": "Pine" },
        { "slug": "pine-deep", "color": "#0E322A", "name": "Deep pine" },
        { "slug": "pine-tint", "color": "#E4EDE8", "name": "Pale pine" },
        { "slug": "bone",      "color": "#F7F7F4", "name": "Bone" },
        { "slug": "ink",       "color": "#111512", "name": "Ink" },
        { "slug": "ink-soft",  "color": "#4A524C", "name": "Soft ink" },
        { "slug": "line",      "color": "#D8DBD6", "name": "Line" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        { "slug": "heading", "name": "Space Grotesk", "fontFamily": "\"Space Grotesk\", system-ui, sans-serif" },
        { "slug": "body",    "name": "IBM Plex Sans", "fontFamily": "\"IBM Plex Sans\", system-ui, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small",   "size": "15px", "name": "Small" },
        { "slug": "medium",  "size": "17px", "name": "Body" },
        { "slug": "large",   "size": "27px", "name": "Heading" },
        { "slug": "x-large", "size": "38px", "name": "Display" }
      ]
    },
    "spacing": { "units": [ "px", "rem", "%" ] }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--bone)", "text": "var(--wp--preset--color--ink)" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--pine)" } },
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "lineHeight": "1.12" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "lineHeight": "1.15" } },
      "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "lineHeight": "1.3" } }
    }
  }
}
